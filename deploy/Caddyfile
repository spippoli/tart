{$TART_SITE_ADDRESS:localhost} {
	# The client's address goes to `api` and `frontend` in this header, which Caddy
	# always overwrites; the app reads the client IP from nowhere else, never from
	# X-Forwarded-For (Foundations spec, Rate limits). `api` must stay unreachable
	# except through Caddy and `frontend`.
	# Uploads (Foundations spec, 3): one file per request, at most the Instance's
	# `media.max_upload_mb` plus 1 MB of multipart framing, set as
	# TART_UPLOAD_BODY_LIMIT; `api` checks the file's exact size. A larger body gets
	# the same translatable error code as the app's refusal.
	@upload {
		method POST
		path /api/media
	}
	request_body @upload {
		max_size {$TART_UPLOAD_BODY_LIMIT:26MiB}
	}
	handle_errors 413 {
		header Content-Type application/json
		respond `{"code":"file_too_large"}` 413
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Tart-Client-IP {client_ip}
		}
	}
	# Basemap extracts from the tiles volume (Discovery spec, Basemap tiles): byte
	# ranges, no `encode`, and immutable, since each file name carries its build.
	@tiles path /tiles/basemap-*.pmtiles
	handle @tiles {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# The map style's assets (fonts, glyphs, sprites, overlays) from the configuration
	# directory's map/. Their names carry no version: cached for an hour, not immutable.
	# Served from the site's origin, so nothing in them may run or be sniffed as a page,
	# and hidden files (`.git`, editor leftovers) are not served.
	handle /map/* {
		root * /srv/config
		header Cache-Control "public, max-age=3600"
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server {
			hide .*
		}
	}
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Tart-Client-IP {client_ip}
		}
	}
}
