# Copy to .env and fill in. Secrets live only in the environment, never in the configuration directory.

# The TART release to run: a version from the GitHub Releases page, without the "v"
# (for example 0.3.0). `tart upgrade <version>` changes it; never use `latest`.
# For development from source, set it to dev.
TART_VERSION=

TART_SITE_ADDRESS=localhost
POSTGRES_USER=tart
POSTGRES_DB=tart
# Letters and digits only: it is also written into the DATABASE_URL of `api` and `worker`.
POSTGRES_PASSWORD=

# Development from source only: build the images from the repository instead of
# pulling the released ones (compose.dev.yaml, which also adds Mailpit with --profile dev).
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
