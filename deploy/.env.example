# Copy to .env and fill in. Secrets live only in the environment, never in the configuration directory.

# The TART release to run: a version from the GitHub Releases page, without the "v"
# (for example 0.3.0). `tart upgrade <version>` changes it; never use `latest`.
# For development from source, set it to dev.
TART_VERSION=

TART_SITE_ADDRESS=localhost
POSTGRES_USER=tart
POSTGRES_DB=tart
# Letters and digits only: it is also written into the DATABASE_URL of `api` and `worker`.
POSTGRES_PASSWORD=

# The Instance configuration directory on the host (instance.toml, vocabularies,
# texts, identity, geography, map), mounted read-only into `api` and `worker`;
# Caddy serves its map/ at /map/. It
# holds no secret. `docker compose run --rm api tart config check` validates it.
# For development from source, Rome's reference configuration (placeholder launch
# values) or the tests' fictional one works:
# CONFIG_DIR=../instances/rome
# CONFIG_DIR=../backend/tests/fixtures/config/valid
CONFIG_DIR=./config

# The largest upload request Caddy lets through: the configuration's
# media.max_upload_mb plus 1, in MiB (25 MB per file by default, so 26MiB).
# Change both together.
TART_UPLOAD_BODY_LIMIT=26MiB

# Signs the session cookies: a random string of at least 32 characters, for example
# the output of `openssl rand -hex 32`. Changing it signs every User out.
SESSION_KEY=

# Where uploaded files are stored: filesystem (the default, in the media-data volume)
# or s3, an S3-compatible object storage. s3 needs every S3_ variable.
STORAGE_BACKEND=filesystem
# S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# The SMTP server that sends the emails. SMTP_SECURITY is starttls (the default,
# usually port 587), tls (usually port 465), or none (in clear: Mailpit only).
# For development with Mailpit (--profile dev): SMTP_HOST=mailpit,
# SMTP_PORT=1025, and SMTP_SECURITY=none; its UI is on http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
# The From address of every email; the From name is the archive name.
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Monitoring. An external monitor of your choice (Uptime Kuma on another machine, or a
# hosted service) polls https://<your site>/api/health, which answers only ok (200) or
# fail (503). The details, each check with its value and threshold, need this token
# (at least 32 characters, for example `openssl rand -hex 32`):
#   curl -H "Authorization: Bearer $HEALTH_DETAILS_TOKEN" https://<your site>/api/health/details
# Without it, the details are refused.
HEALTH_DETAILS_TOKEN=
# The worker emails this address when a check fails, at most once a day per check, in
# the Instance's default UI language: a role address read by at least two people.
# Without it, no alert email is sent.
OPERATOR_ALERT_EMAIL=
# The backup repository. While it is unset, the backup and verify checks are a
# not_configured warning, which does not turn /api/health to fail.
# RESTIC_REPOSITORY=
# Health thresholds, to override the defaults: worker heartbeat younger than 120
# seconds, oldest queued job younger than 900 seconds, at most 0 emails failed in 24
# hours, free disk above 20 percent, last backup younger than 93600 seconds (26 hours),
# last verify younger than 691200 seconds (8 days).
# HEALTH_WORKER_HEARTBEAT_MAX_AGE=120
# HEALTH_JOB_QUEUE_MAX_AGE=900
# HEALTH_EMAIL_MAX_FAILED=0
# HEALTH_DISK_MIN_FREE_PERCENT=20
# HEALTH_BACKUP_MAX_AGE=93600
# HEALTH_VERIFY_MAX_AGE=691200

# The worker's memory limit (a Compose size such as 1g or 1536m).
WORKER_MEMORY_LIMIT=1g

# Development from source only: build the images from the repository instead of
# pulling the released ones (compose.dev.yaml, which also adds Mailpit with --profile dev).
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Every service logs into the host's journal (see the comment in compose.yaml for the
# journal settings). On a machine without journald, such as Docker Desktop, development
# needs Docker's own logs instead:
# TART_LOG_DRIVER=json-file
