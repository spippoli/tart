{
  "version": 8,
  "name": "PLACEHOLDER Rome style, dark: replaced by the reference style of issue #144",
  "metadata": {
    "tart:insert-archive-below": "street-labels",
    "tart:basemap-schema": 4,
    "tart:tokens": {
      "map.paper": "#1E1B18",
      "map.ink": "#EAE2D5",
      "marker.ink": "#F6F0E6",
      "map.label.district": "#C9AE9A",
      "map.block": "#3A2A25"
    },
    "placeholder": "Not Rome's style: a provisional copy of the tests' fixture style, so that this directory passes the map style rules until issue #144 replaces it."
  },
  "glyphs": "/map/glyphs/{fontstack}/{range}.pbf",
  "sprite": "/map/sprites/basemap",
  "font-faces": {
    "Sorts Mill Goudy Regular": "/map/fonts/SortsMillGoudy-Regular.ttf",
    "Sorts Mill Goudy Italic": "/map/fonts/SortsMillGoudy-Italic.ttf",
    "Sorts Mill Goudy Small Caps": [
      {
        "url": "/map/fonts/SortsMillGoudy-Regular.ttf",
        "unicode-range": [
          "U+0000-00FF"
        ]
      }
    ]
  },
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles:///tiles/basemap.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#1E1B18"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#18252B"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "park",
          "#222A20",
          "#1E1B18"
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "buildings",
      "paint": {
        "fill-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          "#1E1B18",
          15,
          "#3A2A25"
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "basemap",
      "source-layer": "roads",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#EAE2D5",
        "line-width": 1
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "roads",
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Sorts Mill Goudy Regular"
        ]
      },
      "paint": {
        "text-color": "#DCD2C5",
        "text-halo-color": "#1E1B18",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "pois",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "pois",
      "layout": {
        "icon-image": "dot"
      }
    }
  ]
}
