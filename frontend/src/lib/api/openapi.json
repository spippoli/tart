{
  "openapi": "3.1.0",
  "info": {
    "title": "TART API",
    "version": "0.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Config",
        "description": "The public subset of the Instance configuration, which the frontend caches.",
        "operationId": "config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfiguration"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/code": {
      "post": {
        "summary": "Request Code",
        "description": "Send a one-time code to the address, or what the address gets instead; the\nanswer never says which addresses have accounts.",
        "operationId": "request_code_api_auth_code_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Request Code Api Auth Code Post"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateLimitedError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/code/verify": {
      "post": {
        "summary": "Verify Code",
        "description": "Check the code: sign in, ask for the registration step (send it again with the\ncode and `registration`), or refuse with an error code.",
        "operationId": "verify_code_api_auth_code_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeAttemptBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verified"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "summary": "Session",
        "description": "The signed-in User, or null; the frontend's server asks on every page.",
        "operationId": "session_api_auth_session_get",
        "parameters": [
          {
            "name": "tart_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tart Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "summary": "Sign Out",
        "description": "End this session.",
        "operationId": "sign_out_api_auth_sign_out_post",
        "parameters": [
          {
            "name": "tart_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tart Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out-everywhere": {
      "post": {
        "summary": "Sign Out Everywhere",
        "description": "End every session of the signed-in User, this one included.",
        "operationId": "sign_out_everywhere_api_auth_sign_out_everywhere_post",
        "parameters": [
          {
            "name": "tart_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tart Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/style/{theme}.json": {
      "get": {
        "summary": "Map Style",
        "description": "The map style of one theme, revalidated on every use (`no-cache` with an ETag).",
        "operationId": "map_style_api_map_style__theme__json_get",
        "parameters": [
          {
            "name": "theme",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "light",
                "dark"
              ],
              "type": "string",
              "title": "Theme"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The style, with absolute asset URLs and the current basemap extract",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "description": "The style has not changed since the ETag sent"
          },
          "503": {
            "description": "The style uses the local basemap, and there is no extract yet",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "const": "tiles_missing"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accent": {
        "properties": {
          "light": {
            "type": "string",
            "title": "Light"
          },
          "dark": {
            "type": "string",
            "title": "Dark"
          }
        },
        "type": "object",
        "required": [
          "light",
          "dark"
        ],
        "title": "Accent"
      },
      "Attribution": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "text",
          "url"
        ],
        "title": "Attribution"
      },
      "CodeAttemptBody": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "registration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegistrationBody"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "email",
          "code",
          "language"
        ],
        "title": "CodeAttemptBody"
      },
      "CodeRequestBody": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "website": {
            "type": "string",
            "title": "Website",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "email",
          "language"
        ],
        "title": "CodeRequestBody"
      },
      "Contacts": {
        "properties": {
          "general": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "General"
          },
          "dsa": {
            "type": "string",
            "title": "Dsa"
          },
          "dsa_languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dsa Languages"
          },
          "privacy": {
            "type": "string",
            "title": "Privacy"
          }
        },
        "type": "object",
        "required": [
          "general",
          "dsa",
          "dsa_languages",
          "privacy"
        ],
        "title": "Contacts"
      },
      "DefaultView": {
        "properties": {
          "center": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Center"
          },
          "zoom": {
            "type": "number",
            "title": "Zoom"
          }
        },
        "type": "object",
        "required": [
          "center",
          "zoom"
        ],
        "title": "DefaultView"
      },
      "Error": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Error"
      },
      "Geography": {
        "properties": {
          "country": {
            "type": "string",
            "title": "Country"
          },
          "place_name": {
            "type": "string",
            "title": "Place Name"
          },
          "time_zone": {
            "type": "string",
            "title": "Time Zone"
          },
          "default_view": {
            "$ref": "#/components/schemas/DefaultView"
          },
          "bounds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bounds"
          }
        },
        "type": "object",
        "required": [
          "country",
          "place_name",
          "time_zone",
          "default_view",
          "bounds"
        ],
        "title": "Geography"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Identity": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "logo": {
            "$ref": "#/components/schemas/Logo"
          },
          "favicon": {
            "type": "string",
            "title": "Favicon"
          },
          "accent": {
            "$ref": "#/components/schemas/Accent"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "logo",
          "favicon",
          "accent"
        ],
        "title": "Identity"
      },
      "Languages": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          },
          "ui": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ui"
          }
        },
        "type": "object",
        "required": [
          "content",
          "ui"
        ],
        "title": "Languages"
      },
      "Licenses": {
        "properties": {
          "data": {
            "type": "string",
            "title": "Data"
          },
          "files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Files"
          },
          "data_attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Attribution"
          }
        },
        "type": "object",
        "required": [
          "data",
          "files",
          "data_attribution"
        ],
        "title": "Licenses"
      },
      "Logo": {
        "properties": {
          "light": {
            "type": "string",
            "title": "Light"
          },
          "dark": {
            "type": "string",
            "title": "Dark"
          },
          "alt": {
            "type": "string",
            "title": "Alt"
          }
        },
        "type": "object",
        "required": [
          "light",
          "dark",
          "alt"
        ],
        "title": "Logo"
      },
      "PublicConfiguration": {
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "operator_name": {
            "type": "string",
            "title": "Operator Name"
          },
          "contacts": {
            "$ref": "#/components/schemas/Contacts"
          },
          "languages": {
            "$ref": "#/components/schemas/Languages"
          },
          "geography": {
            "$ref": "#/components/schemas/Geography"
          },
          "map_attribution": {
            "items": {
              "$ref": "#/components/schemas/Attribution"
            },
            "type": "array",
            "title": "Map Attribution"
          },
          "map_tile_origins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Map Tile Origins"
          },
          "vocabularies": {
            "$ref": "#/components/schemas/Vocabularies"
          },
          "registration": {
            "type": "string",
            "enum": [
              "open",
              "invite",
              "closed"
            ],
            "title": "Registration"
          },
          "licenses": {
            "$ref": "#/components/schemas/Licenses"
          },
          "terms_version": {
            "type": "integer",
            "title": "Terms Version"
          },
          "texts": {
            "$ref": "#/components/schemas/Texts"
          }
        },
        "type": "object",
        "required": [
          "identity",
          "operator_name",
          "contacts",
          "languages",
          "geography",
          "map_attribution",
          "map_tile_origins",
          "vocabularies",
          "registration",
          "licenses",
          "terms_version",
          "texts"
        ],
        "title": "PublicConfiguration"
      },
      "RateLimitedError": {
        "properties": {
          "code": {
            "type": "string",
            "const": "rate_limited",
            "title": "Code"
          },
          "retry_after": {
            "type": "integer",
            "title": "Retry After"
          }
        },
        "type": "object",
        "required": [
          "code",
          "retry_after"
        ],
        "title": "RateLimitedError"
      },
      "RegistrationBody": {
        "properties": {
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "age_confirmed": {
            "type": "boolean",
            "title": "Age Confirmed"
          }
        },
        "type": "object",
        "required": [
          "display_name",
          "age_confirmed"
        ],
        "title": "RegistrationBody"
      },
      "SessionState": {
        "properties": {
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SignedInUser"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "user"
        ],
        "title": "SessionState"
      },
      "SignedInUser": {
        "properties": {
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "preferred_language": {
            "type": "string",
            "title": "Preferred Language"
          },
          "moderator": {
            "type": "boolean",
            "title": "Moderator"
          }
        },
        "type": "object",
        "required": [
          "number",
          "display_name",
          "preferred_language",
          "moderator"
        ],
        "title": "SignedInUser"
      },
      "Texts": {
        "properties": {
          "about": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "About"
          },
          "editorial_guidelines": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Editorial Guidelines"
          },
          "contribution_policy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contribution Policy"
          },
          "terms": {
            "type": "string",
            "title": "Terms"
          },
          "privacy": {
            "type": "string",
            "title": "Privacy"
          }
        },
        "type": "object",
        "required": [
          "about",
          "editorial_guidelines",
          "contribution_policy",
          "terms",
          "privacy"
        ],
        "title": "Texts",
        "description": "The Operator texts, Markdown in the Content language."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verified": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "signed_in",
              "registration_required"
            ],
            "title": "Outcome"
          }
        },
        "type": "object",
        "required": [
          "outcome"
        ],
        "title": "Verified"
      },
      "Vocabularies": {
        "properties": {
          "expression_types": {
            "items": {
              "$ref": "#/components/schemas/VocabularyEntry"
            },
            "type": "array",
            "title": "Expression Types"
          },
          "surface_types": {
            "items": {
              "$ref": "#/components/schemas/VocabularyEntry"
            },
            "type": "array",
            "title": "Surface Types"
          },
          "decision_reasons": {
            "items": {
              "$ref": "#/components/schemas/VocabularyEntry"
            },
            "type": "array",
            "title": "Decision Reasons"
          },
          "notice_reasons": {
            "items": {
              "$ref": "#/components/schemas/VocabularyEntry"
            },
            "type": "array",
            "title": "Notice Reasons"
          }
        },
        "type": "object",
        "required": [
          "expression_types",
          "surface_types",
          "decision_reasons",
          "notice_reasons"
        ],
        "title": "Vocabularies",
        "description": "Each in display order; retired entries stay, for display on existing records."
      },
      "VocabularyEntry": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Label"
          },
          "description": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "retired": {
            "type": "boolean",
            "title": "Retired"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "description",
          "retired"
        ],
        "title": "VocabularyEntry"
      }
    }
  }
}
